# --- Base de données (MySQL) ---
DATABASE_URL="mysql://user:password@localhost:3306/job4us"

# --- URL publique de l'application (M1) ---
# Base des liens absolus (réinitialisation de mot de passe, emails de
# notification, metadataBase, sitemap). En production : le domaine réel,
# sans barre oblique finale. En développement : http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth.js (NextAuth v5) ---
# Générer avec : openssl rand -base64 32
AUTH_SECRET=""

# --- Authentification admin (M10) ---
# Clé AES-256-GCM qui chiffre les secrets TOTP en base. 32 octets encodés en
# base64 (base64 de 32 octets, pas 32 caractères). Générer avec :
#   openssl rand -base64 32
# Une clé absente ou invalide fait échouer la connexion admin, jamais le build.
ADMIN_2FA_KEY=""

# --- Stockage privé des fichiers (Cloudflare R2, API S3) ---
# Bucket STRICTEMENT privé : aucun accès public, aucune URL permanente.
# Les téléchargements passent par une URL signée de 5 minutes générée par
# la route /api/files/* après vérification de la matrice d'accès.
# Endpoint = https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_BUCKET="job4us"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# --- Emails transactionnels (Resend, module notifications) ---
# Clé d'API serveur (jamais exposée au client). Sans clé ni expéditeur, le
# cron emails est un no-op : les lignes restent en attente, aucun envoi.
RESEND_API_KEY=""
# Expéditeur vérifié chez Resend : "Job4Us <notifications@votre-domaine>" ou
# l'adresse seule. Aucune valeur par défaut n'est inventée dans le code.
EMAIL_FROM=""

# --- Tâches planifiées (module notifications) ---
# Secret du cron GET /api/cron/notifications : en-tête
# `Authorization: Bearer <CRON_SECRET>`. Absent = route en 503.
# Générer avec : openssl rand -base64 32
CRON_SECRET=""

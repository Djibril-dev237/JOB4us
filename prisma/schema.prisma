generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// UTILISATEURS & AUTH
// ---------------------------------------------------------------------------

model User {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String?   @unique @db.VarChar(150)
  password        String?   @db.VarChar(255)
  role            Role
  avatar          String?   @db.VarChar(255)
  phone           String?   @unique @db.VarChar(20)
  ville           String?   @db.VarChar(100)
  pays            String    @default("Cameroun") @db.VarChar(100)
  isActive        Boolean   @default(true) @map("is_active")
  // M10 : invalidation immédiate des sessions (suspension, révocation).
  // Le JWT porte la valeur au moment de la connexion ; le DAL la compare à
  // la base à chaque lecture autoritaire.
  sessionVersion  Int       @default(0) @map("session_version")
  // M10 : double authentification des admins. Le secret est chiffré avec
  // ADMIN_2FA_KEY, jamais stocké en clair. `totpLastStep` bloque le rejeu
  // d'un même pas de 30 secondes.
  totpSecret      String?   @map("totp_secret") @db.VarChar(255)
  totpEnabledAt   DateTime? @map("totp_enabled_at")
  totpLastStep    Int?      @map("totp_last_step")
  // M10 : procédure CLI d'anonymisation, jamais de suppression physique.
  anonymizedAt    DateTime? @map("anonymized_at")
  emailVerifiedAt DateTime? @map("email_verified_at")
  rememberToken   String?   @map("remember_token")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  candidat                 Candidat?
  entreprise               Entreprise?
  messages                 Message[]
  conversationsEtat        ConversationEtat[]
  blocagesEmis             Blocage[]                @relation("BlocageEmis")
  blocagesRecus            Blocage[]                @relation("BlocageRecus")
  signalementsEmis         Signalement[]            @relation("SignalementAuteur")
  signalementsTraites      Signalement[]            @relation("SignalementTraite")
  notifications            Notification[]
  notificationsReglages    NotificationReglage[]
  notificationsPreferences NotificationPreference[]
  emailsNotifications      EmailNotification[]      @relation("EmailsNotification")
  offresSauvegardees       OffreSauvegardee[]
  accounts                 Account[]
  sessions                 Session[]
  adminInvitations         AdminInvitation[]
  adminRecoveryCodes       AdminRecoveryCode[]
  adminAuthChallenges      AdminAuthChallenge[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// M10 — ACCÈS ADMINISTRATEUR
// ---------------------------------------------------------------------------
// Les comptes admin ne sont jamais créés ni promus depuis l'interface. La CLI
// crée le compte, émet une invitation de 24 heures, puis l'activation définit
// le mot de passe et la double authentification. Les jetons et codes sont
// stockés HACHÉS : le secret en clair ne quitte le serveur qu'une seule fois.
// ---------------------------------------------------------------------------

model AdminInvitation {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "admin_invitations_user_idx")
  @@map("admin_invitations")
}

model AdminRecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @unique @map("code_hash") @db.VarChar(64)
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt], map: "admin_recovery_codes_user_idx")
  @@map("admin_recovery_codes")
}

model AdminAuthChallenge {
  id         String    @id @default(cuid())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt], map: "admin_auth_challenges_user_idx")
  @@map("admin_auth_challenges")
}

enum Role {
  candidat
  recruteur
  admin

  @@map("users_role")
}

// ---------------------------------------------------------------------------
// CANDIDATS, EXPÉRIENCES & FORMATIONS
// ---------------------------------------------------------------------------

model Candidat {
  id            Int           @id @default(autoincrement())
  userId        Int           @unique @map("user_id")
  titreProfil   String?       @map("titre_profil") @db.VarChar(150)
  resume        String?       @db.Text
  cvPath        String?       @map("cv_path")
  dateNaissance DateTime?     @map("date_naissance") @db.Date
  genre         Genre?
  disponibilite Disponibilite @default(immediat)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  competences  CandidatCompetence[]
  candidatures Candidature[]
  experiences  Experience[]
  formations   Formation[]

  @@map("candidats")
}

enum Genre {
  homme
  femme
  autre

  @@map("candidats_genre")
}

enum Disponibilite {
  immediat
  un_mois        @map("1_mois")
  trois_mois     @map("3_mois")
  non_disponible

  @@map("candidats_disponibilite")
}

model Experience {
  id          Int       @id @default(autoincrement())
  candidatId  Int       @map("candidat_id")
  poste       String    @db.VarChar(150)
  entreprise  String    @db.VarChar(150)
  ville       String?   @db.VarChar(100)
  dateDebut   DateTime  @map("date_debut") @db.Date
  dateFin     DateTime? @map("date_fin") @db.Date
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  candidat Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)

  @@index([candidatId], map: "experiences_candidat_id_fkey")
  @@map("experiences")
}

model Formation {
  id            Int       @id @default(autoincrement())
  candidatId    Int       @map("candidat_id")
  diplome       String    @db.VarChar(150)
  etablissement String    @db.VarChar(150)
  ville         String?   @db.VarChar(100)
  dateDebut     DateTime  @map("date_debut") @db.Date
  dateFin       DateTime? @map("date_fin") @db.Date
  description   String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  candidat Candidat @relation(fields: [candidatId], references: [id], onDelete: Cascade)

  @@index([candidatId], map: "formations_candidat_id_fkey")
  @@map("formations")
}

// ---------------------------------------------------------------------------
// ENTREPRISES & RECRUTEURS
// ---------------------------------------------------------------------------

model Entreprise {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  nom              String   @db.VarChar(150)
  description      String?  @db.Text
  secteurActivite  String?  @map("secteur_activite") @db.VarChar(150)
  tailleEntreprise String?  @map("taille_entreprise") @db.VarChar(20)
  siteWeb          String?  @map("site_web")
  emailContact     String?  @map("email_contact")
  telephone        String?
  adresse          String?
  logo             String?
  ville            String?  @db.VarChar(100)
  pays             String   @default("Cameroun") @db.VarChar(100)
  isVerified       Boolean  @default(false) @map("is_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  offres Offre[]

  @@map("entreprises")
}

// ---------------------------------------------------------------------------
// CATÉGORIES & COMPÉTENCES
// ---------------------------------------------------------------------------

model Categorie {
  id        Int      @id @default(autoincrement())
  nom       String   @unique @db.VarChar(100)
  icone     String?  @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  offres Offre[]

  @@map("categories")
}

model Competence {
  id        Int      @id @default(autoincrement())
  nom       String   @unique @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  candidats CandidatCompetence[]
  offres    OffreCompetence[]

  @@map("competences")
}

model CandidatCompetence {
  candidatId   Int              @map("candidat_id")
  competenceId Int              @map("competence_id")
  niveau       NiveauCompetence @default(intermediaire)

  candidat   Candidat   @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  competence Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@id([candidatId, competenceId])
  @@index([competenceId], map: "candidat_competences_competence_id_fkey")
  @@map("candidat_competences")
}

enum NiveauCompetence {
  debutant
  intermediaire
  avance

  @@map("candidat_competences_niveau")
}

model OffreCompetence {
  offreId      Int @map("offre_id")
  competenceId Int @map("competence_id")

  offre      Offre      @relation(fields: [offreId], references: [id], onDelete: Cascade)
  competence Competence @relation(fields: [competenceId], references: [id], onDelete: Cascade)

  @@id([offreId, competenceId])
  @@index([competenceId], map: "offre_competences_competence_id_fkey")
  @@map("offre_competences")
}

// ---------------------------------------------------------------------------
// OFFRES D'EMPLOI & CANDIDATURES
// ---------------------------------------------------------------------------

model Offre {
  id               Int              @id @default(autoincrement())
  entrepriseId     Int              @map("entreprise_id")
  categorieId      Int              @map("categorie_id")
  titre            String           @db.VarChar(200)
  description      String           @db.LongText
  typeContrat      TypeContrat      @map("type_contrat")
  niveauExperience NiveauExperience @map("niveau_experience")
  ville            String           @db.VarChar(100)
  pays             String           @default("Cameroun") @db.VarChar(100)
  salaireMin       Decimal?         @map("salaire_min") @db.Decimal(10, 2)
  salaireMax       Decimal?         @map("salaire_max") @db.Decimal(10, 2)
  salaireVisible   Boolean          @default(false) @map("salaire_visible")
  dateExpiration   DateTime         @map("date_expiration") @db.Date
  // Cycle de vie M6 (étape 2 validée) : 4 statuts stockés (l'ancien
  // booléen is_active, qui fusionnait brouillon et suspension, est
  // supprimé) — voir enum StatutOffre + migration m6.
  statut           StatutOffre      @default(brouillon)
  // Suppression LOGIQUE M6 (étape 2) : jamais de delete physique —
  // candidatures.offre_id est en cascade, l'historique M7 doit survivre.
  deletedAt        DateTime?        @map("deleted_at")
  vues             Int              @default(0) @db.UnsignedInt
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  // URL publique (M5) : « titre-slug-<id> », unique, nullable car ajouté
  // sur table peuplée (backfill dans la migration) — voir src/lib/slug.ts.
  slug             String?          @unique @db.VarChar(220)

  entreprise   Entreprise         @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  categorie    Categorie          @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  candidatures Candidature[]
  competences  OffreCompetence[]
  savedByUsers OffreSauvegardee[]

  @@index([categorieId], map: "offres_categorie_id_fkey")
  @@index([entrepriseId], map: "offres_entreprise_id_fkey")
  // Liste publique M5 : WHERE statut='publiee' AND deleted_at IS NULL
  // AND date_expiration >= jour ORDER BY created_at DESC LIMIT 10 —
  // statut en tête (égalité très sélective, ex-booléen is_active),
  // created_at en second pour le tri sans filesort ; justification
  // détaillée dans la migration (parcours inversé de l'index).
  @@index([statut, createdAt, dateExpiration], map: "offres_visibles_liste_idx")
  @@map("offres")
}

// Table pivot explicite (timestamps Laravel, PK composite).
// Remplace le M-N implicite Prisma pour rester fidele a offres_sauvegardees.
model OffreSauvegardee {
  userId    Int      @map("user_id")
  offreId   Int      @map("offre_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offre Offre @relation(fields: [offreId], references: [id], onDelete: Cascade)

  @@id([userId, offreId])
  @@index([offreId], map: "offres_sauvegardees_offre_id_fkey")
  @@map("offres_sauvegardees")
}

enum TypeContrat {
  CDI
  CDD
  stage
  freelance
  temps_partiel

  @@map("offres_type_contrat")
}

// Cycle de vie d'une offre (M6 étape 2) : les transitions autorisées sont
// vérifiées côté serveur (compare-and-set) — « expirée » et « supprimée »
// ne sont PAS des statuts : la première est dérivée de dateExpiration à
// chaque lecture (aucun cron de statut), la seconde vit dans deletedAt.
// M9 notifie les candidats des offres expirées via son propre cron de
// notifications : il lit ces deux champs sans écrire de statut.
enum StatutOffre {
  brouillon
  publiee
  cloturee
  suspendue

  @@map("offres_statut")
}

enum NiveauExperience {
  sans_experience
  junior
  intermediaire
  senior

  @@map("offres_niveau_experience")
}

model Candidature {
  id               Int               @id @default(autoincrement())
  offreId          Int               @map("offre_id")
  candidatId       Int               @map("candidat_id")
  lettreMotivation String?           @map("lettre_motivation") @db.Text
  cvPath           String?           @map("cv_path")
  statut           StatutCandidature @default(envoyee)
  noteRecruteur    String?           @map("note_recruteur") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  offre        Offre         @relation(fields: [offreId], references: [id], onDelete: Cascade)
  candidat     Candidat      @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  // M8 : une conversation par candidature (clé portée par Conversation).
  conversation Conversation?

  @@unique([offreId, candidatId])
  // M7 : l'index FK simple `candidatId` devient composite (candidatId,
  // created_at) — même colonne de tête, donc la contrainte FK reste
  // couverte, et la liste paginée du candidat (ORDER BY created_at DESC,
  // 15/page) est lue depuis l'index sans filesort.
  @@index([candidatId, createdAt], map: "candidatures_candidat_id_fkey")
  // Filtres du recruteur : WHERE offre_id = ? AND statut = ? — l'index
  // unique (offre_id, candidat_id) filtre offre_id mais pas statut (2e
  // axe d'égalité très sélectif : 'envoyee' domine) ; created_at en
  // troisième pour le tri de la liste.
  @@index([offreId, statut, createdAt], map: "candidatures_offre_statut_idx")
  @@map("candidatures")
}

// ---------------------------------------------------------------------------
// JOURNAL D'ACCÈS AUX FICHIERS SENSIBLES (audit Étape 1 : aucune journalisation)
// ---------------------------------------------------------------------------

/**
 * Journal APPEND-ONLY des lectures de CV par un recruteur ou un admin
 * (matrice Étape 2 : « admin = lecture justifiée + journal » ; le candidat
 * lisant son propre CV n'est pas un événement sensible et n'est pas journalisé).
 * Conception délibérée :
 * - AUCUNE clé étrangère : la trace survit à la suppression d'un compte
 * (intégrité d'audit > intégrité référentielle) ;
 * - pas d'updatedAt : table en ajout pur, jamais mise à jour ;
 * - `cibleCandidatId` = l'identifiant du profil CV lu (la cible du fichier).
 */
model AccesFichier {
  id              Int      @id @default(autoincrement())
  acteurId        Int      @map("acteur_id")
  cibleCandidatId Int      @map("cible_candidat_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([acteurId], map: "acces_fichiers_acteur_id_idx")
  @@index([cibleCandidatId], map: "acces_fichiers_cible_candidat_id_idx")
  @@index([createdAt], map: "acces_fichiers_created_at_idx")
  @@map("acces_fichiers")
}

// ---------------------------------------------------------------------------
// JOURNAL D'AUDIT DES CANDIDATURES (M7, tâche 11 : « qui a changé quel
// statut, quand ») — même doctrine que AccesFichier, ci-dessus :
// - AUCUNE clé étrangère : la trace survit à la suppression d'un compte et
//   à la suppression physique d'une ligne (intégrité d'audit > intégrité
//   référentielle) ;
// - pas d'updatedAt : table en ajout pur, jamais mise à jour ;
// - `action` = nature de l'événement (création, transition, retrait,
//   consultation de CV), `ancienStatut` NULL pour la création.
// Les transitions sont journées UNIQUEMENT par l'action serveur
// (aucun chemin client ne peut écrire ici : la table n'a pas de route).
model AuditCandidature {
  id            Int      @id @default(autoincrement())
  candidatureId Int      @map("candidature_id")
  acteurId      Int      @map("acteur_id")
  action        String   @db.VarChar(50)
  ancienStatut  String?  @map("ancien_statut") @db.VarChar(30)
  nouveauStatut String?  @map("nouveau_statut") @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([candidatureId], map: "audit_candidatures_candidature_id_idx")
  @@index([acteurId], map: "audit_candidatures_acteur_id_idx")
  @@index([createdAt], map: "audit_candidatures_created_at_idx")
  @@map("audit_candidatures")
}

// M7 / étape 2 validée — 7 statuts remplacent l'ENUM 5 valeurs du legacy
// ('envoyee','vue','retenue','refusee','entretien') : `vue` → `consultee`,
// `retenue` → `preselectionnee` (terminologie validée), `acceptee` n'existait
// pas (le legacy s'arrêtait à `retenue`), `retiree` remplace la SUPPRESSION
// PHYSIQUE du legacy (diagnostic #11 : perte d'historique) — conformément à
// schema.prisma « l'historique M7 doit survivre ». L'ENUM MySQL garantit la
// liste en base ; les TRANSITIONS sont contrôlées côté serveur
// (src/lib/candidatures-labels.ts, testé exhaustivement).
enum StatutCandidature {
  envoyee
  consultee
  preselectionnee
  entretien
  acceptee
  refusee
  retiree

  @@map("candidatures_statut")
}

// ---------------------------------------------------------------------------
// MESSAGERIE & NOTIFICATIONS
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// M8 — MESSAGERIE : une conversation PAR CANDIDATURE (Étape 2 validée).
// Les participants ne sont JAMAIS copiés : ils se dérivent de la candidature
// (candidat postulant + propriétaire courant de l'offre) à chaque accès —
// aucune table de participants à désynchroniser, et le contrôle
// d'appartenance tombe dans la même requête que la lecture.
// ---------------------------------------------------------------------------
model Conversation {
  id            Int      @id @default(autoincrement())
  // Une seule conversation par candidature : contrainte DB → doublon
  // structurellement impossible, y compris en course (contrairement à
  // l'ancien unique (candidat, recruteur, offre) poreux avec offre NULL).
  candidatureId Int      @unique @map("candidature_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  candidature Candidature        @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  messages    Message[]
  etats       ConversationEtat[]

  @@map("conversations")
}

// Contenu en texte BRUT (jamais de HTML) — le serveur nettoie et
// tronque à 2000 caractères (messagerie-contenu.ts, Étape 2 §6/§7).
// Pas d'updatedAt : les messages sont immuables (append-only).
model Message {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  senderId       Int      @map("sender_id")
  contenu        String   @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  signalements Signalement[]

  // Curseur de pagination (WHERE conversation_id = ? AND created_at < ?)
  // — colonne de tête = FK couverte, pas de filesort. Le senderId garde
  // son index FK (compteurs de non-lus par expéditeur).
  @@index([conversationId, createdAt], map: "messages_conv_created_idx")
  @@index([senderId], map: "messages_sender_id_fkey")
  @@map("messages")
}

// MASQUAGE / RÉTABLISSEMENT D'UN MESSAGE (M10) — journal append-only de
// l'effet de modération. Message reste immuable : l'état courant est la
// dernière ligne de ce journal. Aucune clé étrangère, même doctrine que les
// audits : la trace survit à toute suppression et ne peut être modifiée.
enum MessageModerationAction {
  masquage
  retablissement

  @@map("message_moderation_action")
}

model MessageModeration {
  id            Int                     @id @default(autoincrement())
  messageId     Int                     @map("message_id")
  signalementId Int?                    @map("signalement_id")
  acteurId      Int                     @map("acteur_id")
  action        MessageModerationAction
  motif         String                  @db.VarChar(50)
  noteInterne   String?                 @map("note_interne") @db.Text
  createdAt     DateTime                @default(now()) @map("created_at")

  @@index([messageId, createdAt, id], map: "message_moderation_message_idx")
  @@index([signalementId], map: "message_moderation_signalement_idx")
  @@index([acteurId], map: "message_moderation_acteur_idx")
  @@map("message_moderation")
}

// ÉTAT PAR PARTICIPANT (Étape 2 §4/§8) : masquage logique et accusé de
// lecture — un seul UPDATE par ouverture de conversation (luLe), jamais
// un UPDATE par message comme l'ancien is_lu global.
model ConversationEtat {
  conversationId Int       @map("conversation_id")
  userId         Int       @map("user_id")
  masqueLe       DateTime? @map("masque_le")
  luLe           DateTime? @map("lu_le")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  // Liste « mes conversations » : exclusion des masquées de mon côté
  // (WHERE user_id = ? AND masque_le IS NULL) sans scan de la table.
  @@index([userId, masqueLe], map: "conv_etat_user_masque_idx")
  @@map("conversations_etat")
}

// BLOCAGE À PORTÉE GLOBALE (Étape 2 §5) : bloquer vaut pour toutes les
// conversations entre les deux acteurs ET pour les futures (nouvelle
// candidature ≠ nouvelle porte de relance).
model Blocage {
  id         Int      @id @default(autoincrement())
  bloqueurId Int      @map("bloqueur_id")
  bloqueId   Int      @map("bloque_id")
  createdAt  DateTime @default(now()) @map("created_at")

  bloqueur User @relation("BlocageEmis", fields: [bloqueurId], references: [id], onDelete: Cascade)
  bloque   User @relation("BlocageRecus", fields: [bloqueId], references: [id], onDelete: Cascade)

  @@unique([bloqueurId, bloqueId])
  // « ai-je bloqué X » / « qui m'a bloqué » en indexé.
  @@index([bloqueId], map: "blocages_bloque_idx")
  @@map("blocages")
}

enum StatutSignalement {
  ouvert
  traite

  @@map("signalements_statut")
}

// DÉCISION DE MODÉRATION (M10) — vocabulaire fermé, une seule décision par
// signalement traité. `suspension` implique le masquage du message signalé ;
// l'effet est matérialisé dans MessageModeration, jamais par un UPDATE du
// message lui-même.
enum SignalementDecision {
  sans_suite
  avertissement
  masquage
  suspension

  @@map("signalements_decision")
}

// SIGNALEMENT D'UN MESSAGE (Étape 2 §5) : un participant peut signaler
// même bloqué (le blocage ne doit pas couvrir le harcèlement).
model Signalement {
  id            Int                  @id @default(autoincrement())
  messageId     Int                  @map("message_id")
  auteurId      Int                  @map("auteur_id")
  motif         String               @db.VarChar(300)
  statut        StatutSignalement    @default(ouvert)
  decision      SignalementDecision? @map("decision")
  motifDecision String?              @map("motif_decision") @db.VarChar(50)
  noteInterne   String?              @map("note_interne") @db.Text
  traiteParId   Int?                 @map("traite_par_id")
  traiteLe      DateTime?            @map("traite_le")
  createdAt     DateTime             @default(now()) @map("created_at")

  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  auteur    User    @relation("SignalementAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  traitePar User?   @relation("SignalementTraite", fields: [traiteParId], references: [id], onDelete: SetNull)

  // Pas de doublon : un seul signalement par (message, auteur).
  @@unique([messageId, auteurId])
  // File de modération : WHERE statut = 'ouvert' ORDER BY created_at.
  @@index([statut, createdAt], map: "signalements_statut_idx")
  // Statistiques : délai moyen de traitement sur 30 jours.
  @@index([statut, traiteLe], map: "signalements_statut_traite_idx")
  @@map("signalements")
}

// JOURNAL DE CONSULTATION ADMIN (Étape 2 §2) — même doctrine que
// AuditCandidature (M7) : AUCUNE clé étrangère (la trace survit aux
// suppressions), append-only, acteur = session.userId. Seule la
// consultation depuis un signalement ouvert est tracée ici.
model AuditConversation {
  id             Int      @id @default(autoincrement())
  conversationId Int      @map("conversation_id")
  acteurId       Int      @map("acteur_id")
  signalementId  Int?     @map("signalement_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([conversationId], map: "audit_conversations_conversation_id_idx")
  @@index([acteurId], map: "audit_conversations_acteur_id_idx")
  @@index([createdAt], map: "audit_conversations_created_at_idx")
  @@map("audit_conversations")
}

// JOURNAL D'AUDIT GÉNÉRIQUE (M10) — trace immuable de toute action sensible
// d'administration. Aucune clé étrangère, aucun updatedAt : l'acteur et la
// cible sont des identifiants historiques, pas des relations vivantes. Une
// vue MySQL en lecture seule agrège aussi les journaux M7/M8 existants.
model JournalAudit {
  id          Int      @id @default(autoincrement())
  acteurId    Int      @map("acteur_id")
  action      String   @db.VarChar(80)
  cibleType   String   @map("cible_type") @db.VarChar(30)
  cibleId     Int?     @map("cible_id")
  motif       String?  @db.VarChar(50)
  commentaire String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "journal_audit_created_idx")
  @@index([acteurId, createdAt], map: "journal_audit_acteur_idx")
  @@index([cibleType, cibleId, createdAt], map: "journal_audit_cible_idx")
  @@index([action, createdAt], map: "journal_audit_action_idx")
  @@map("journal_audit")
}

// NOTIFICATION IN-APP (M9) — reprise du miroir legacy, durcie :
//  * `type` passe de VARCHAR à l'ENUM FERMÉ du catalogue (9 valeurs du
//    module notifications-labels) : un type hors catalogue est structurel-
//    ment impossible ;
//  * `cle` est l'IDEMPOTENCE : clé déterministe calculée par l'émission
//    (`type:ref:destinataire`), unique — un événement rejoué ne produit
//    jamais une seconde notification, le create lève P2002 ;
//  * `compteur` + `dernierRefId` portent le REGROUPEMENT : une seule ligne
//    par conversation pour `nouveauMessage`, compteur incrémenté à chaque
//    message RÉELLEMENT nouveau (`dernierRefId` = id du dernier message
//    traité, rejou d'un message déjà compté = aucun incrément) ;
//  * cycle de vie : nonLue → lue (`lueLe`) → archivee (`archiveeLe`, 30 j
//    après la lecture par le cron) → purge (90 j après archivage) ;
//  * `isLu` garde son nom legacy : le compteur de la cloche M2
//    (header.tsx) reste littéralement inchangé.
//
// Les colonnes `titre`/`contenu`/`lien` sont remplies À L'ÉMISSION par la
// fabrique `texteNotification()` (TEXTES unique) et les liens vers les
// PAGES PROPRES de l'utilisateur — jamais la ressource, jamais un texte de
// message, jamais une coordonnée (règle de confidentialité Étape 2).
// ---------------------------------------------------------------------------
enum TypeNotification {
  candidatureRecue
  statutCandidature
  candidatureRetiree
  nouveauMessage
  offreIndisponible
  signalementRecu
  offrePubliee
  entrepriseCertifiee
  // 9e type ajouté à l'arbitrage de la Vague 1 : la notification legacy
  // « nouvel utilisateur inscrit » (RegisterController.php, parité M4)
  // s'adressait aux admins et n'avait pas d'équivalent au catalogue —
  // in-app SEULEMENT (legacy n'envoyait aucun email).
  systeme
  // M10 : information de l'auteur d'un signalement sur la décision prise.
  // Type non désactivable et email activé par défaut (devoir de modération).
  moderation

  @@map("notifications_type")
}

model Notification {
  id           Int              @id @default(autoincrement())
  userId       Int              @map("user_id")
  type         TypeNotification
  cle          String           @unique @db.VarChar(200)
  titre        String           @db.VarChar(200)
  contenu      String?          @db.Text
  isLu         Boolean          @default(false) @map("is_lu")
  compteur     Int              @default(1)
  dernierRefId Int?             @map("dernier_ref_id")
  lueLe        DateTime?        @map("lue_le")
  archiveeLe   DateTime?        @map("archivee_le")
  lien         String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails EmailNotification[]

  // Compteur de la cloche (header M2) : `userId + isLu = false`.
  @@index([userId, isLu], map: "notifications_user_lu_idx")
  // Liste paginée par curseur [createdAt, id] (les archivées sont filtrées
  // en séléction, pas en index).
  @@index([userId, createdAt], map: "notifications_user_created_idx")
  // Cron d'archivage : WHERE isLu = true AND archiveeLe IS NULL AND lueLe < seuil.
  @@index([isLu, lueLe], map: "notifications_archivage_idx")
  // Cron de purge : WHERE archiveeLe < seuil.
  @@index([archiveeLe], map: "notifications_purge_idx")
  @@map("notifications")
}

// PRÉFÉRENCE PAR TYPE (M9) — ligne ABSENTE = défaut du catalogue
// (preferencesParDefaut(), jamais de seed) : seul l'écart est stocké.
// `signalementRecu` n'a AUCUNE ligne possible (non désactivable) : l'émission
// ignore les préférences pour ce type (devoir de modération).
// ---------------------------------------------------------------------------
model NotificationPreference {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  type        TypeNotification
  emailActive Boolean          @map("email_active")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// RÉGLAGES PAR COMPTE (M9) — ligne ABSENTE = défauts ci-dessous :
//  * `emailsActives` : le KILL SWITCH du désabonnement 1-clic (faux = plus
//    aucun email métier, in-app inchangé) ; `signalementRecu` le traverse
//    toujours (sécurité) ;
//  * `resumeQuotidien` : digest OFF par défaut (arbitrage Étape 2).
// ---------------------------------------------------------------------------
model NotificationReglage {
  userId          Int      @id @map("user_id")
  emailsActives   Boolean  @default(true) @map("emails_actives")
  resumeQuotidien Boolean  @default(false) @map("resume_quotidien")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_reglages")
}

enum StatutEmail {
  enAttente
  envoye
  abandonne

  @@map("emails_statut")
}

// OUTBOX EMAILS (M9) — file d'attente DURABLE entre l'émission et l'envoi :
//  * `cle` idempotence (un événement rejoué = UNE ligne) ;
//  * échec d'envoi JAMAIS bloquant : `tentatives` + `prochaineTentative`
//    (reprise), puis `abandonne` propre après le plafond de tentatives —
//    l'action métier n'attend jamais Resend ;
//  * `erreur` = message technique TRONQUÉ, jamais de donnée personnelle ;
//  * plafonds 6/h et 30/j par destinataire : comptés sur `createdAt` ;
//  * digest quotidien : `notificationId`/`type` nuls + `resumeDu` (date de
//    période) — l'unicité (destinataire, resumeDu) garantit UN digest par
//    jour et par compte (les lignes non-digest ont `resumeDu` NULL, non
//    conflitantes dans l'index unique MySQL).
// ---------------------------------------------------------------------------
model EmailNotification {
  id                 Int               @id @default(autoincrement())
  cle                String            @unique @db.VarChar(200)
  destinataireId     Int               @map("destinataire_id")
  notificationId     Int?              @map("notification_id")
  type               TypeNotification?
  resumeDu           DateTime?         @map("resume_du")
  statut             StatutEmail       @default(enAttente)
  tentatives         Int               @default(0)
  prochaineTentative DateTime?         @map("prochaine_tentative")
  envoyeLe           DateTime?         @map("envoye_le")
  erreur             String?           @db.VarChar(300)
  createdAt          DateTime          @default(now()) @map("created_at")

  destinataire User          @relation("EmailsNotification", fields: [destinataireId], references: [id], onDelete: Cascade)
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  // Digest : un seul résumé par compte et par jour (NULLs non conflitants).
  @@unique([destinataireId, resumeDu], map: "emails_resume_uniq")
  // Ramassage de la file : WHERE statut = enAttente AND prochaineTentative < now.
  @@index([statut, prochaineTentative], map: "emails_drain_idx")
  // Plafonds 6/h et 30/j par destinataire (compté sur createdAt).
  @@index([destinataireId, createdAt], map: "emails_plafond_idx")
  @@map("emails_notifications")
}

// ---------------------------------------------------------------------------
// AUTH.JS (NextAuth) — tables adapter Prisma
// Sessions JWT pour credentials ; ces tables restent disponibles pour
// un éventuel lien OAuth (Account) et la compatibilité Auth.js.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            Int     @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @db.Text
  session_state     String? @map("session_state")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "accounts_user_id_fkey")
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_fkey")
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}
